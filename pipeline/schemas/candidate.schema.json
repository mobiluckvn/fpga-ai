{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDP candidate list",
  "type": "object",
  "required": ["round", "origin", "base_config", "candidates"],
  "properties": {
    "round": {"type": "integer", "minimum": 1},
    "origin": {"enum": ["ai", "rules", "human_replay"]},
    "mode": {"enum": ["blind_open", "blind_catalog", "open"]},
    "base_config": {"type": "string", "description": "tên đặc tả YAML làm điểm xuất phát"},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "title", "target", "evidence", "spec", "estimate_method", "expected_mechanism"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
          "template": {"type": "string", "description": "id trong catalog nếu dùng; bỏ trống nếu đề xuất tự do"},
          "title": {"type": "string"},
          "target": {"type": "string", "description": "lớp/vòng/mẫu nào trong analysis.json bị nhắm tới (trích id)"},
          "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1,
                       "description": "trích dẫn số từ analysis.json (đường dẫn trường + giá trị) — không tự bịa số"},
          "spec": {
            "type": "object",
            "description": "đủ để hiện thực: với lệnh mới thì encoding+semantics_python+latency; với L3 thì các tham số timing đổi; với firmware thì biến đổi",
            "properties": {
              "encoding": {"type": "object", "properties": {"opcode": {"type": "string"}, "funct3": {"type": "string"}, "funct7": {"type": "string"}}},
              "semantics_python": {"type": "string"},
              "latency_cycles": {"type": "integer"},
              "timing_changes": {"type": "object"},
              "firmware_changes": {"type": "string"},
              "hw_resources_guess": {"type": "object", "description": "ước lượng định tính: số MULT, cổng BSRAM, thanh ghi kiến trúc mới"}
            }
          },
          "estimate_method": {"enum": ["iss_plugin", "iss_timing", "iss_firmware", "analytic"]},
          "expected_mechanism": {"type": "string", "description": "vì sao giảm chu kỳ — loại chu kỳ nào bị cắt"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
