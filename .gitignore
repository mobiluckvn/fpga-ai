# Python
.venv/
.venv-model/

# Dữ liệu MNIST thô (tải lại bằng lệnh trong docs/HUONG_DAN.md; SHA256 ở env/VERSIONS.md)
model/data/*.gz
__pycache__/
*.pyc

# Thư mục build tạm của từng cổng (vật phẩm đã được lưu lại trong results/ qua
# scripts/archive_gate.sh, nên thư mục build không cần vào git)
build/
obj_dir/

# File tạm
*.o
*.elf
*.vvp
*.vcd
*.fst
.DS_Store

# Tarball công cụ (cài ở ~/tools, không nằm trong repo)
*.tgz
*.tar.gz

# ---- NGOẠI LỆ: mọi thứ trong results/ đều phải được commit ----
# Đây là bằng chứng của báo cáo: bitstream, netlist, log thô, CSV, manifest.
!results/**

# bản sao riscv-tests (ghim commit trong env/VERSIONS.md, tải lại bằng git clone)
rtl/mycore/tests/riscv-tests/

# Thư mục chạy của pipeline CDP: mỗi lệnh một thư mục (meta.json + log thô).
# Bằng chứng của từng bước đã được sao vào results/pipeline/S<n>/ nên không commit.
pipeline/runs/*
!pipeline/runs/.gitkeep

# Cây bóng để cdp dựng ngoài cây (chỉ symlink + thư mục build mới)
pipeline/work/

# Thư mục dựng firmware/biến thể RTL (vật phẩm đã lưu trong results/pipeline/)
experiment/m1s_s6/c*/
experiment/m1s_s6/v*/
# Thư mục/vật phẩm build của các biến thể MỚI (S6, S7). Bằng chứng đã lưu trong
# results/pipeline/S6 và S7, nên không commit thư mục build như các biến thể bv*.
# KHÔNG dùng mẫu rộng (obj_dir*/, rvt*/, Vsoc_b*) vì các biến thể bv* cũ ĐÃ được
# theo dõi trong git — mẫu rộng sẽ chặn cả việc `git add` khi chúng thay đổi.
rtl/mycore/bs6*/
rtl/mycore/bs7*/
rtl/mycore/obj_dir100/
rtl/mycore/obj_dir110/
rtl/mycore/obj_dir111p/
rtl/mycore/obj_dir111pd/
rtl/mycore/rvt111pd/
rtl/mycore/Vsoc_b100
rtl/mycore/Vsoc_b110
rtl/mycore/Vsoc_b111p
rtl/mycore/Vsoc_b111pd
rtl/mycore/verilator100.log
rtl/mycore/verilator110.log
rtl/mycore/verilator111p.log
rtl/mycore/verilator111pd.log
